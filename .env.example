# Analyse des villes par l'IA à la fin du questionnaire « Trouver ma ville ».
# Gemini (gratuit) : créez une clé sur https://aistudio.google.com/apikey. Elle est utilisée en priorité.
GEMINI_API_KEY=
# Facultatif : forcer un modèle en premier. Sinon la chaîne est :
# gemini-3.1-flash-lite → gemini-3-flash-preview → gemini-3.5-flash → gemini-2.5-flash-lite → gemini-2.5-flash
GEMINI_MODEL=
# Ou Claude (payant) si GEMINI_API_KEY est vide. Sans aucune clé, le site affiche son propre classement.
ANTHROPIC_API_KEY=
# Adresse définitive du site (utilisée pour le sitemap et les balises Open Graph).
SITE_URL=
# Mot de passe de la page /admin, où l'agence retrouve les demandes du questionnaire et du simulateur.
ADMIN_PASSWORD=
# Uniquement si le site est hébergé sur Vercel : jeton du magasin Blob (Storage › Blob).
# Sur Netlify, les demandes sont enregistrées automatiquement.
BLOB_READ_WRITE_TOKEN=
