# Copiez ce fichier vers .env et remplissez les valeurs en local.
# Ne mettez jamais de vraies clés dans ce fichier (il est versionné).

# Analyse IA (questionnaire / simulateur). Clé : https://aistudio.google.com/apikey
# En ligne (Vercel), la même variable est aussi lue au build pour un secours depuis le navigateur.
GEMINI_API_KEY=
# Facultatif : forcer un modèle en premier.
GEMINI_MODEL=
# Ou Claude si GEMINI_API_KEY est vide.
ANTHROPIC_API_KEY=

# Adresse définitive du site (sitemap, Open Graph).
SITE_URL=

# Mot de passe de la page /admin (inutile tant que les demandes partent par e-mail).
ADMIN_PASSWORD=

# Destinataire des demandes. Vide = adresse définie dans src/data/site.ts
LEAD_EMAIL=

# Facultatif : envoi d’e-mails côté serveur (https://resend.com). Sinon, FormSubmit depuis le navigateur.
RESEND_API_KEY=
