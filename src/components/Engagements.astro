---
/* « Pourquoi nous » : tout ce qui est inclus pour acheter ou vendre, puis nos engagements.
   Utilisé sur l'accueil, Alyah, L'agence et Réalisations. */
import { SITE, waLink } from "../data/site";

const BUY = [
  { t: "Recherche et visites", d: "Choix de la ville et du quartier, sélection des biens, visites sur place ou en vidéo." },
  { t: "Négociation", d: "Estimation du juste prix et négociation avec le vendeur." },
  { t: "Avocat", d: "Vérification au Tabou, permis et dettes éventuelles, rédaction et relecture du contrat." },
  { t: "Banque et prêt", d: "Comparaison des banques, recherche du meilleur taux, montage du dossier et rendez‑vous à la banque avec vous." },
  { t: "Taxes et frais", d: "Calcul de la taxe d’achat (Mas Rechisha) et des avantages olim, budget complet avant l’offre." },
  { t: "Signature et clés", d: "Signature, enregistrement au Tabou, remise des clés, arnona, eau et électricité à votre nom." },
  { t: "Travaux si besoin", d: "Plans par notre architecte et chantier par nos artisans, avant ou après votre arrivée." },
];
const SELL = [
  { t: "Estimation", d: "Prix de vente fixé à partir des ventes récentes du quartier." },
  { t: "Mise en valeur", d: "Petits travaux utiles, photos professionnelles, annonces." },
  { t: "Visites et négociation", d: "Sélection des acheteurs sérieux, visites, négociation du prix et des délais." },
  { t: "Avocat", d: "Contrat, vérification du financement de l’acheteur, taxe sur la plus‑value (Mas Shevach)." },
  { t: "Signature et remise des clés", d: "Signature, transfert de l’arnona et des compteurs, remise des clés." },
];
const PROMISES = [
  { t: "Un interlocuteur, en français", d: "Un conseiller qui connaît votre dossier et coordonne tout le monde, joignable sur WhatsApp." },
  { t: "Des visites en vidéo", d: "Encore à l’étranger ? Nous visitons pour vous, en direct, avec un avis franc." },
  { t: "Les chiffres par écrit", d: "Prix, frais, taxes, mensualité : tout est chiffré avant la moindre décision." },
  { t: `${SITE.years} ans sur le terrain`, d: "Nous connaissons les quartiers, les écoles, les banques et les prix réels." },
];
---
<div class="allin">
  <div class="allin-col">
    <div class="allin-head"><span class="tag-note">Pour acheter</span><h3>Tout le parcours, sans rien gérer seul</h3></div>
    <ol class="allin-list">{BUY.map((x) => <li><b>{x.t}</b><span>{x.d}</span></li>)}</ol>
  </div>
  <div class="allin-col">
    <div class="allin-head"><span class="tag-note">Pour vendre</span><h3>Vendre au bon prix, en toute sécurité</h3></div>
    <ol class="allin-list">{SELL.map((x) => <li><b>{x.t}</b><span>{x.d}</span></li>)}</ol>
    <div class="allin-cta">
      <b>Vous pensez vendre ?</b>
      <span>Recevez une estimation gratuite de votre bien, sans engagement.</span>
      <a class="btn btn-wa" href={waLink("Bonjour, je souhaite faire estimer mon bien en Israël.")} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#wa" /></svg>Faire estimer mon bien</a>
      <small>Vous préférez louer ou faire gérer votre bien ? Voir <a href="/gestion">Gestion de votre bien</a>.</small>
    </div>
  </div>
</div>
<div class="promises">
  {PROMISES.map((p) => <div><h3>{p.t}</h3><p>{p.d}</p></div>)}
</div>
