---
/* Nos engagements, noir sur blanc. */
import { SITE } from "../data/site";
const ITEMS = [
  { t: "Un avocat dans chaque dossier", d: "Vérification au Tabou (cadastre), contrat, taxes et signature : notre avocat francophone suit chaque achat et chaque vente.", i: "M12 3v18M5 7h14M7 7l-3 7a3 3 0 0 0 6 0L7 7Zm10 0-3 7a3 3 0 0 0 6 0l-3-7Z" },
  { t: "Un interlocuteur, en français", d: "Un conseiller qui connaît votre dossier, joignable sur WhatsApp, du premier échange à la remise des clés.", i: "M4 5h16v11H8l-4 4V5Z" },
  { t: "Des visites en vidéo", d: "Si vous êtes encore à l’étranger, nous visitons pour vous, en direct, et vous donnons un avis franc sur chaque bien.", i: "M3 7h12v10H3zM15 10l6-3v10l-6-3" },
  { t: "Les chiffres avant la décision", d: "Prix, frais, taxes, mensualités ou rendement : vous les avez par écrit avant de faire une offre.", i: "M4 20V10M10 20V4M16 20v-7M22 20H2" },
  { t: "Nos propres artisans", d: "Maçons, électriciens, plombiers, menuisiers : des équipes avec lesquelles nous travaillons depuis des années.", i: "m14 6 4 4M3 21l3-1 12-12-2-2L4 18l-1 3Z" },
  { t: `${SITE.years} ans sur le terrain`, d: "Nous connaissons les quartiers, les écoles, les synagogues et les prix réels de chaque ville où nous travaillons.", i: "M4 20V9l8-5 8 5v11M9 20v-6h6v6" },
];
---
<div class="engage">
  {ITEMS.map((it) => (
    <div class="engage-item">
      <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={it.i} /></svg></span>
      <h3>{it.t}</h3>
      <p>{it.d}</p>
    </div>
  ))}
</div>
