---
interface Props { items: { title: string; text: string; who: string }[] }
const { items } = Astro.props;
---
<ol class="steps" style={`--n:${items.length}`}>
  {items.map((s, i) => <li class="step"><div class="dot" aria-hidden="true">{i + 1}</div><h3>{s.title}</h3><p>{s.text}</p><span class="who">{s.who}</span></li>)}
</ol>
