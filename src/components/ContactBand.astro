---
/* Bandeau de contact en bas de page. */
import { waLink } from "../data/site";
interface Props { title?: string; text?: string; message?: string }
const { title = "Un projet immobilier en Israël ?", text = "Parlez‑en à un conseiller francophone. Premier échange sans engagement, sur WhatsApp ou par e‑mail.", message = "Bonjour, je souhaite parler de mon projet immobilier en Israël." } = Astro.props;
---
<section class="contact-band">
  <div class="wrap contact-band-in">
    <div><h2>{title}</h2><p>{text}</p></div>
    <div class="cta">
      <a class="btn btn-wa btn-lg" href={waLink(message)} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#wa" /></svg>Écrire sur WhatsApp</a>
      <a class="btn btn-outline-light btn-lg" href="/contact">Autres moyens de contact</a>
    </div>
  </div>
</section>
