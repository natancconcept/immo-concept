---
import { SITE, logoMark, waLink, phoneDisplay } from "../data/site";
import Icon from "./Icon.astro";
import { CITIES, REGIONS } from "../data/cities";
import { SERVICES, TOOLS, AGENCY } from "../data/nav";
import { questionnaireLink } from "../data/questionnaire";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isIn = (links: { href: string }[]) => links.some((l) => path === l.href.split("?")[0]);
const cur = (href: string) => (path === href.split("?")[0] ? "page" : undefined);
---
<header class="top">
  <div class="wrap top-in">
    <a class="logo" href="/" aria-label={`${SITE.name}, accueil`}>
      <span class="logo-mark" aria-hidden="true">{logoMark}</span>
      <span class="logo-text"><b>{SITE.name}</b><small>Immobilier francophone en Israël</small></span>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      <div class:list={["dd", { current: isIn(SERVICES) }]}>
        <button type="button" aria-expanded="false">Services</button>
        <div class="dd-panel">
          {SERVICES.map((s) => <a class="dd-item" href={s.href} aria-current={cur(s.href)}><b>{s.title}</b><span>{s.desc}</span></a>)}
        </div>
      </div>
      <div class:list={["dd", { current: path.startsWith("/villes") }]}>
        <button type="button" aria-expanded="false">Villes</button>
        <div class="dd-panel dd-cities">
          {REGIONS.map((r) => <div><h4>{r}</h4>{CITIES.filter((c) => c.region === r).map((c) => <a href={`/villes/${c.id}`}>{c.name}</a>)}</div>)}
          <a class="dd-all" href="/villes">Comparer les {CITIES.length} villes ›</a>
        </div>
      </div>
      <div class:list={["dd", { current: isIn(TOOLS) }]}>
        <button type="button" aria-expanded="false">Outils</button>
        <div class="dd-panel">
          {TOOLS.map((s) => <a class="dd-item" href={s.href}><b>{s.title}</b><span>{s.desc}</span></a>)}
        </div>
      </div>
      <div class:list={["dd", { current: isIn(AGENCY) }]}>
        <button type="button" aria-expanded="false">L’agence</button>
        <div class="dd-panel">
          {AGENCY.map((s) => <a class="dd-item" href={s.href} aria-current={cur(s.href)}><b>{s.title}</b><span>{s.desc}</span></a>)}
        </div>
      </div>
    </nav>
    <div class="top-actions">
      <a class="btn btn-primary btn-sm btn-find" href={questionnaireLink("olim")}><svg aria-hidden="true"><use href="#pin" /></svg><span>Trouver ma ville</span></a>
      <a class="btn btn-wa btn-sm" href={waLink()} target="_blank" rel="noopener" aria-label="WhatsApp"><svg aria-hidden="true"><use href="#wa" /></svg><span>WhatsApp</span></a>
      <button type="button" class="burger" aria-controls="mmenu" aria-expanded="false"><i></i><span>Menu</span></button>
    </div>
  </div>
</header>

<div class="mmenu" id="mmenu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="mmenu-head">
    <a class="logo" href="/"><span class="logo-mark" aria-hidden="true">{logoMark}</span><span class="logo-text"><b>{SITE.name}</b></span></a>
    <button type="button" class="mmenu-close" aria-label="Fermer le menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
  </div>
  <nav class="mm-body" aria-label="Menu mobile">
    <p class="mm-label">Nos services</p>
    <div class="mm-group">
      {SERVICES.map((s) => (
        <a class="mm-row" href={s.href} aria-current={cur(s.href)}>
          <Icon name={s.icon!} tone={s.tone} />
          <span class="mm-text"><b>{s.title}</b><small>{s.menu}</small></span>
          <span class="mm-chev" aria-hidden="true"></span>
        </a>
      ))}
    </div>

    <p class="mm-label">Outils gratuits</p>
    <div class="mm-group">
      {TOOLS.map((s) => (
        <a class="mm-row" href={s.href} aria-current={cur(s.href)}>
          <Icon name={s.icon!} tone={s.tone} />
          <span class="mm-text"><b>{s.title}</b><small>{s.menu}</small></span>
          <span class="mm-chev" aria-hidden="true"></span>
        </a>
      ))}
    </div>

    <p class="mm-label">Découvrir</p>
    <div class="mm-group">
      <details class="mm-acc" open={path.startsWith("/villes") || undefined}>
        <summary class="mm-row"><Icon name="search" tone="mint" /><span class="mm-text"><b>Nos villes</b><small>{CITIES.length} villes, prix et vie sur place</small></span><span class="mm-chev" aria-hidden="true"></span></summary>
        <div class="mm-cities">
          {REGIONS.map((r) => <div><span>{r}</span>{CITIES.filter((c) => c.region === r).map((c) => <a href={`/villes/${c.id}`} aria-current={cur(`/villes/${c.id}`)}>{c.name}</a>)}</div>)}
          <a class="mm-all" href="/villes">Comparer toutes les villes</a>
        </div>
      </details>
      {AGENCY.map((s) => <a class="mm-row mm-simple" href={s.href} aria-current={cur(s.href)}><span class="mm-text"><b>{s.title}</b></span><span class="mm-chev" aria-hidden="true"></span></a>)}
    </div>

    <div class="mm-contact">
      <span>Un conseiller vous répond en français</span>
      <a href={waLink()} target="_blank" rel="noopener">{phoneDisplay()}</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </nav>
  <div class="mm-foot">
    <a class="btn btn-primary" href={questionnaireLink("olim")}><svg aria-hidden="true"><use href="#pin" /></svg>Trouver ma ville</a>
    <a class="btn btn-wa" href={waLink()} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#wa" /></svg>WhatsApp</a>
  </div>
</div>

<script>
  // Menus déroulants (clic / clavier) et menu mobile.
  const dds = [...document.querySelectorAll<HTMLElement>(".dd")];
  const close = (except?: HTMLElement) => dds.forEach((d) => { if (d !== except) { d.classList.remove("open"); d.querySelector("button")!.setAttribute("aria-expanded", "false") } });
  dds.forEach((d) => {
    const b = d.querySelector("button")!;
    b.addEventListener("click", () => { const open = !d.classList.contains("open"); close(d); d.classList.toggle("open", open); b.setAttribute("aria-expanded", String(open)) });
  });
  document.addEventListener("click", (e) => { if (!(e.target as Element).closest(".dd")) close() });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") { close(); setMenu(false) } });
  const menu = document.getElementById("mmenu")!, burger = document.querySelector<HTMLButtonElement>(".burger")!;
  const closeBtn = menu.querySelector<HTMLButtonElement>(".mmenu-close")!;
  let hideTimer = 0;
  const setMenu = (open: boolean) => {
    if (open === menu.classList.contains("open")) return;
    clearTimeout(hideTimer);
    if (open) { menu.hidden = false; requestAnimationFrame(() => menu.classList.add("open")); closeBtn.focus({ preventScroll: true }) }
    else { menu.classList.remove("open"); hideTimer = window.setTimeout(() => (menu.hidden = true), 260); burger.focus({ preventScroll: true }) }
    document.body.classList.toggle("menu-open", open);
    burger.setAttribute("aria-expanded", String(open));
  };
  burger.addEventListener("click", () => setMenu(true));
  closeBtn.addEventListener("click", () => setMenu(false));
  // Un lien vers une ancre de la page courante ferme aussi le menu.
  menu.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((a) => a.addEventListener("click", () => setMenu(false)));
</script>
