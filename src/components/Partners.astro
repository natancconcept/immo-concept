---
/* Cartes des partenaires : type, nom, descriptif et lien vers le site officiel. */
import { PARTNERS } from "../data/partners";
import Photo from "./Photo.astro";
---
<div class="partners">
  {PARTNERS.map((p) => (
    <article class="partner">
      <div class="partner-head">
        {p.logo
          ? <span class="partner-logo"><Photo src={p.logo} alt={`Logo ${p.name}`} sizes="56px" widths={[112]} /></span>
          : <span class={`partner-mark ico-${p.tone}`} aria-hidden="true">{p.initials}</span>}
        <div><span class="partner-kind">{p.kind}</span><h3>{p.name}</h3></div>
      </div>
      <p>{p.desc}</p>
      <a class="btn btn-ghost partner-btn" href={p.url} target="_blank" rel="noopener">
        Visiter le site officiel
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
        <span class="sr-only">(nouvel onglet)</span>
      </a>
    </article>
  ))}
</div>
<p class="partners-note">Organismes indépendants de notre agence. Leurs services sont décrits sur leurs sites officiels.</p>
