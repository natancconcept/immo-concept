---
import type { City } from "../data/cities";
import Photo from "./Photo.astro";
import { fmt, shekK } from "../lib/format";
interface Props { city: City }
const { city: c } = Astro.props;
const tags = [c.franco >= 2 ? "Communauté francophone" : "", c.sea === 3 ? "Bord de mer" : "", c.house >= 3 ? "Maisons" : "", c.dati === 3 ? "Vie religieuse" : "", c.tech === 3 ? "Emplois high‑tech" : ""].filter(Boolean).slice(0, 2);
---
<a class="city-card" href={`/villes/${c.id}`}>
  <div class="cc-media"><Photo src={c.photo} alt={c.photoAlt} sizes="(max-width: 600px) 100vw, 33vw" widths={[400, 700, 1000]} /></div>
  <div class="cc-body">
    <span class="cc-region">{c.region}</span>
    <b>{c.name}</b>
    <span class="cc-price">{c.avg ? <>{shekK(c.avg)} <small>prix moyen d’un appartement</small></> : <>≈ {fmt(c.m2)} ₪/m² <small>estimation</small></>}</span>
    {tags.length > 0 && <span class="cc-tags">{tags.map((t) => <i>{t}</i>)}</span>}
  </div>
</a>
