---
import type { City } from "../data/cities";
import Photo from "./Photo.astro";
import { fmt, shekK } from "../lib/format";
interface Props { city: City; big?: boolean }
const { city: c, big = false } = Astro.props;
const tags = [c.franco >= 2 ? "Francophones" : "", c.sea === 3 ? "Bord de mer" : "", c.house >= 3 ? "Maisons" : "", c.dati === 3 ? "Vie religieuse" : "", c.tech === 3 ? "High‑tech" : ""].filter(Boolean).slice(0, 2);
---
<a class:list={["city-card", { big }]} href={`/villes/${c.id}`}>
  <div class="cc-media">
    <Photo src={c.photo} alt={c.photoAlt} sizes={big ? "(max-width: 700px) 100vw, 50vw" : "(max-width: 700px) 100vw, 25vw"} widths={[400, 700, 1000]} />
    <span class="cc-region">{c.region}</span>
  </div>
  <div class="cc-body">
    <b>{c.name}</b>
    <span class="cc-price">{c.avg ? <>{shekK(c.avg)} <small>prix moyen</small></> : <>≈ {fmt(c.m2)} ₪/m² <small>estimation</small></>}</span>
    <span class="cc-tags">{tags.map((t) => <i>{t}</i>)}</span>
  </div>
  <span class="cc-go" aria-hidden="true">→</span>
</a>
