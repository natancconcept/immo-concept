---
import Base from "../layouts/Base.astro";
import CityCard from "../components/CityCard.astro";
import Photo from "../components/Photo.astro";
import Engagements from "../components/Engagements.astro";
import Testimonials from "../components/Testimonials.astro";
import ContactBand from "../components/ContactBand.astro";
import { SITE } from "../data/site";
import { CITIES, HOME_CITIES } from "../data/cities";
import { SERVICES, TOOLS } from "../data/nav";
const home = HOME_CITIES.map((id) => CITIES.find((c) => c.id === id)).filter((c) => !!c);
const POINTS: Record<string, string[]> = {
  "/alyah": ["Choix de la ville et du quartier", "Visites sur place ou en vidéo", "Vérification juridique et financement"],
  "/investissement": ["Étude de rentabilité avant l’achat", "Location ou rénovation‑revente", "Choix des villes selon le rendement"],
  "/gestion": ["Travaux et rénovation par nos artisans", "Recherche de locataires et bail", "Gestion au quotidien ou revente"],
};
---
<Base title="Agence immobilière francophone en Israël" description={`Agence immobilière francophone en Israël : achat et location pour votre alyah, investissement, gestion et rénovation de votre bien. Avocats, architectes et artisans, depuis ${SITE.years} ans.`}>
  <section class="hero">
    <Photo src={SITE.heroPhoto} alt="Tel Aviv et Jaffa vues du ciel, au bord de la Méditerranée" class="hero-img" sizes="100vw" widths={[640, 1024, 1600]} eager />
    <div class="hero-shade"></div>
    <div class="wrap hero-in">
      <span class="kicker">Achat · Location · Investissement · Gestion</span>
      <h1>Agence immobilière francophone en Israël</h1>
      <p class="hero-lead">Nous accompagnons les francophones qui achètent, louent, investissent ou possèdent un bien en Israël : recherche du bien, vérifications par notre avocat, financement, travaux, location et gestion. Une seule équipe, en français, du premier échange à la remise des clés.</p>
      <div class="cta">
        <a class="btn btn-primary btn-lg" href="#services">Voir nos services</a>
        <a class="btn btn-outline-light btn-lg" href="/contact">Parler à un conseiller</a>
      </div>
      <div class="hero-facts">
        <span><b>{SITE.years} ans</b> d’expérience en Israël</span>
        <span><b>{CITIES.length} villes</b> suivies</span>
        <span><b>Avocat</b> dans chaque dossier</span>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Nos services</span>
        <h2>Que souhaitez‑vous faire en Israël ?</h2>
        <p class="lead">Y vivre, investir, ou faire gérer un bien que vous possédez : une même équipe pour les trois.</p>
      </div>
      <div class="services">
        {SERVICES.map((s) => (
          <a class="service" href={s.href}>
            <Photo src={s.photo!} alt={s.photoAlt!} sizes="(max-width: 900px) 100vw, 33vw" widths={[480, 800]} />
            <div class="service-body">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <ul>{POINTS[s.href].map((p) => <li>{p}</li>)}</ul>
              <span class="link">En savoir plus</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap intro">
      <div class="intro-text">
        <span class="kicker">L’agence</span>
        <h2 style="margin:12px 0 20px">Tous les métiers de l’immobilier, sous le même toit</h2>
        <p>Acheter en Israël quand on vient de France, c’est une autre langue, d’autres règles et d’autres usages. Notre agence réunit des conseillers francophones, des avocats, un architecte et des artisans de tous corps de métier.</p>
        <p>Vous avez un seul interlocuteur, qui coordonne tout le monde et vous tient informé sur WhatsApp, que vous soyez en France ou déjà installé.</p>
        <a class="link" href="/agence">Découvrir l’agence</a>
      </div>
      <div class="facts">
        <div><b>{SITE.years} ans</b><span>d’accompagnement en Israël</span></div>
        <div><b>{CITIES.length}</b><span>villes suivies, surtout les grandes</span></div>
        <div><b>Avocats</b><span>intégrés à chaque dossier</span></div>
        <div><b>Artisans</b><span>de tous corps de métier</span></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Notre méthode</span>
        <h2>Comment se déroule un achat avec nous</h2>
      </div>
      <ol class="method">
        <li><b>Votre projet</b><span>Un premier échange, ou le questionnaire en ligne, pour comprendre votre famille, votre budget et vos priorités.</span></li>
        <li><b>La sélection</b><span>Des biens choisis pour vous, visités sur place ou en vidéo, avec notre avis sur chacun.</span></li>
        <li><b>Les vérifications</b><span>Notre avocat contrôle le Tabou, les permis, les dettes éventuelles et le contrat avant toute offre.</span></li>
        <li><b>Les clés</b><span>Financement, signature, enregistrement, et si besoin des travaux réalisés par nos artisans.</span></li>
      </ol>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="row-head">
        <div class="sec-head">
          <span class="kicker">Nos villes</span>
          <h2>Où vivre en Israël ?</h2>
          <p class="lead">Prix, loyers, vie sur place et quartiers recherchés : une fiche détaillée pour chaque ville.</p>
        </div>
        <a class="btn btn-ghost" href="/villes">Les {CITIES.length} villes</a>
      </div>
      <div class="city-grid three">
        {home.map((c) => <CityCard city={c} />)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Outils gratuits</span>
        <h2>Préparez votre projet en ligne</h2>
      </div>
      <div class="tools">
        {TOOLS.map((t) => <a class="tool" href={t.href}><h3>{t.title}</h3><p>{t.desc}</p><span class="link">{t.href.startsWith("/simulateur") ? "Faire une simulation" : "Répondre au questionnaire"}</span></a>)}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Pourquoi nous</span>
        <h2>Nos engagements</h2>
      </div>
      <Engagements />
    </div>
  </section>

  <Testimonials />

  <ContactBand />
</Base>
