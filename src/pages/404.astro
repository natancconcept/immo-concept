---
import Base from "../layouts/Base.astro";
import { questionnaireLink } from "../data/questionnaire";
import PageHero from "../components/PageHero.astro";
---
<Base title="Page introuvable" description="Cette page n’existe pas ou a été déplacée.">
  <PageHero photo="coucher-soleil-plage" photoAlt="Coucher de soleil sur la plage" crumbs={[{ label: "Page introuvable" }]}
    title="Cette page est introuvable." lead="Elle a peut‑être été déplacée. Reprenez depuis l’accueil ou trouvez directement votre ville.">
    <a class="btn btn-primary btn-lg" href="/">Retour à l’accueil</a>
    <a class="btn btn-ghost btn-lg" href={questionnaireLink("olim")}>Trouver ma ville</a>
  </PageHero>
</Base>
