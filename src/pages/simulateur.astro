---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ContactBand from "../components/ContactBand.astro";
import Related from "../components/Related.astro";
import Simulator from "../components/Simulator.astro";
---
<Base title="Simulateur de budget immobilier par ville" description="Acheter, louer, investir ou rénover pour revendre : estimez prix, mensualités, loyers, rendement et plus‑value dans 14 villes d’Israël.">
  <PageHero photo="interieur-vue-mer" photoAlt="Salle à manger avec vue sur la mer" crumbs={[{ label: "Simulateur" }]}
    eyebrow="Outil gratuit" title="Simulateur de budget immobilier"
    lead="Achat, location, investissement ou rénovation : choisissez une ville et une surface pour obtenir un ordre de grandeur. Nous affinons ensuite avec vous, bien par bien." />
  <section>
    <div class="wrap"><Simulator /></div>
  </section>
  <Related exclude="/simulateur" />
  <ContactBand />
</Base>
