---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Steps from "../components/Steps.astro";
import Simulator from "../components/Simulator.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import FormSection from "../components/FormSection.astro";
import Related from "../components/Related.astro";
import { PUBLIC_PROJECTS } from "../data/gallery";
const PROJECTS = PUBLIC_PROJECTS();
import { shekK } from "../lib/format";
---
<Base title="Rénovation et revente (coup de fusil) en Israël" description="Opérations d’achat, rénovation et revente (« coup de fusil ») en Israël : repérage d’un bien sous‑évalué, plans par notre architecte, travaux tous corps de métier, revente et partage de la plus‑value.">
  <PageHero photo="cuisine-en-travaux" photoAlt="Cuisine en cours de rénovation" he="שיפוץ" eyebrow="Rénovation & revente" crumbs={[{ label: "Rénovation & revente" }]}
    title="Acheter, rénover et revendre avec une plus‑value"
    lead="Ce que l’on appelle un « coup de fusil » : nous repérons un bien vendu sous le prix du marché, notre architecte le repense, nos artisans le rénovent entièrement, puis nous le revendons. Vous investissez et suivez chaque étape.">
    <a class="btn btn-primary btn-lg" href="#formulaire">Proposer une opération</a>
    <a class="btn btn-ghost btn-lg" href="#simulateur">Simuler une plus‑value</a>
  </PageHero>
  <section>
    <div class="wrap">
      <div class="sec-head"><span class="kicker">Étape par étape</span><h2>On s’occupe de tout, vous suivez l’avancement</h2><p class="lead">Chaque étape est tenue par un professionnel de notre équipe. Vous recevez photos et comptes rendus sur WhatsApp.</p></div>
      <Steps items={[
        { title: "Achat", text: "Repérage d’un bien sous le prix du marché, négociation, compromis.", who: "Agent + avocat" },
        { title: "Architecture", text: "Nouveaux plans, choix des matériaux, demandes de permis si besoin.", who: "Architecte" },
        { title: "Travaux", text: "Maçonnerie, électricité, plomberie, cuisine, sols, peinture.", who: "Tous corps de métier" },
        { title: "Revente", text: "Photos professionnelles, mise en vente, visites et négociation.", who: "Agent" },
        { title: "Plus‑value", text: "Signature chez l’avocat et répartition du bénéfice selon le contrat.", who: "Avocat" },
      ]} />
    </div>
  </section>
  <section class="alt" id="simulateur">
    <div class="wrap">
      <div class="sec-head"><span class="kicker">Simulateur</span><h2>Combien peut rapporter une opération ?</h2></div>
      <Simulator mode="flip" city="telaviv" />
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="sec-head"><span class="kicker">Avant / Après</span><h2>Glissez pour voir la transformation</h2></div>
      {PROJECTS.length > 0 ? (
        <div class="ba-grid" id="flipProjects">
          <div>
            {PROJECTS.map((p, i) => (
              <div class="proj-view" data-i={i} hidden={i !== 0}>
                <BeforeAfter before={p.before} after={p.after} kind={p.kind} seed={p.seed} label={`${p.title}, ${p.city}`} big />
                <div class="figs"><div><small>Achat</small><b>{shekK(p.buy)}</b></div><div><small>Travaux</small><b>{shekK(p.works)}</b></div><div><small>Revente</small><b>{shekK(p.sale)}</b></div><div><small>Durée</small><b>{p.months} mois</b></div></div>
              </div>
            ))}
          </div>
          <div class="projects">
            {PROJECTS.map((p, i) => <button type="button" class="proj" data-i={i} aria-pressed={i === 0 ? "true" : "false"}><b>{p.title}</b><span class="meta">{p.city} · {p.months} mois de travaux {p.demo && <>· <span class="ph">exemple</span></>}</span></button>)}
          </div>
        </div>
      ) : (
        <div class="ba-grid">
          <div>
            <BeforeAfter before="chantier-avant" after="cuisine-moderne" kind="kitchen" seed={11} label="un appartement à rénover, puis refait à neuf" big />
            <p class="photo-note">Photos d’illustration. Nos chantiers réels, avec leurs chiffres, seront présentés ici.</p>
          </div>
          <div>
            <h3 style="font-size:24px;margin-bottom:12px">Ce que change une rénovation complète</h3>
            <ul class="ticks">
              <li>Plans repensés par notre architecte : plus de lumière, plus d’espace utile</li>
              <li>Électricité, plomberie, cuisine, salle de bain et sols entièrement refaits</li>
              <li>Un bien prêt à vivre, qui se vend plus vite et plus cher</li>
              <li>Photos et compte rendu chaque semaine sur WhatsApp</li>
            </ul>
          </div>
        </div>
      )}
    </div>
  </section>
  <FormSection eyebrow="Votre projet" title="Participer à une opération" lead="Dites‑nous votre capital et votre horizon, on vous présente les prochaines opérations." goal="flip" />
  <Related exclude="/renovation-revente" />
</Base>

<script>
  const root = document.getElementById("flipProjects");
  if (root) root.querySelectorAll<HTMLButtonElement>(".proj").forEach((b) => b.addEventListener("click", () => {
    root.querySelectorAll<HTMLElement>(".proj-view").forEach((v) => (v.hidden = v.dataset.i !== b.dataset.i));
    root.querySelectorAll(".proj").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
  }));
</script>
