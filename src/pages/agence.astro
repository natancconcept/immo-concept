---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Photo from "../components/Photo.astro";
import Engagements from "../components/Engagements.astro";
import Related from "../components/Related.astro";
import ContactBand from "../components/ContactBand.astro";
import { SITE } from "../data/site";
import { CITIES, REGIONS } from "../data/cities";
---
<Base title="L’agence : qui sommes‑nous" description={`${SITE.name}, agence immobilière francophone en Israël depuis ${SITE.years} ans : conseillers, avocats, architecte et artisans réunis pour acheter, louer, investir ou rénover.`}>
  <PageHero photo="promenade-tel-aviv" photoAlt="Promenade au bord de la mer en Israël" eyebrow="L’agence" crumbs={[{ label: "L’agence" }]}
    title="Une agence francophone, tous les métiers de l’immobilier"
    lead={`Depuis ${SITE.years} ans, nous aidons les francophones à acheter, louer, investir et rénover en Israël, avec une équipe qui réunit conseillers, avocats, architecte et artisans.`}>
    <a class="btn btn-primary btn-lg" href="/contact">Nous contacter</a>
  </PageHero>

  <section>
    <div class="wrap split">
      <div>
        <span class="kicker">Qui nous sommes</span>
        <h2 style="margin:12px 0 18px">Un seul interlocuteur pour tout votre projet</h2>
        <div class="prose">
          <p>Acheter un bien en Israël depuis la France, ou juste après son alyah, soulève beaucoup de questions : quelle ville, quel quartier, quelles écoles, quel prix est juste, quelles taxes, comment obtenir un prêt, à qui confier des travaux.</p>
          <p>Notre agence a été pensée pour y répondre en un seul endroit, en français. Votre conseiller coordonne l’avocat, la banque, l’architecte et les artisans, et vous tient informé à chaque étape.</p>
          <p>Nous travaillons dans tout le pays, avec une priorité pour les grandes villes où vivent la plupart des francophones.</p>
        </div>
      </div>
      <Photo src="interieur-vue-mer" alt="Appartement lumineux avec vue sur la mer" sizes="(max-width: 900px) 100vw, 50vw" widths={[480, 800, 1100]} />
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="sec-head"><span class="kicker">Notre équipe</span><h2>Les métiers réunis dans l’agence</h2></div>
      <div class="team">
        <div><h3>Conseillers francophones</h3><p>Ils sélectionnent les biens, organisent les visites, comparent les banques pour votre prêt et vous accompagnent à chaque rendez‑vous.</p></div>
        <div><h3>Avocats</h3><p>Vérification au Tabou, permis, contrats, taxes d’achat et de vente, signature et enregistrement.</p></div>
        <div><h3>Architecte</h3><p>Plans de rénovation, choix des matériaux, demandes de permis quand elles sont nécessaires.</p></div>
        <div><h3>Artisans</h3><p>Maçonnerie, électricité, plomberie, menuiserie, cuisine, sols et peinture : tous corps de métier.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head"><span class="kicker">Pourquoi nous</span><h2>Tout compris, de la recherche aux clés</h2></div>
      <Engagements />
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="sec-head"><span class="kicker">Où nous intervenons</span><h2>{CITIES.length} villes suivies en détail</h2><p class="lead">Et partout en Israël sur demande.</p></div>
      <div class="related">
        {REGIONS.map((r) => <div class="card"><h3 style="font-size:19px">{r}</h3><p>{CITIES.filter((c) => c.region === r).map((c, i, a) => <><a href={`/villes/${c.id}`}>{c.name}</a>{i < a.length - 1 ? " · " : ""}</>)}</p></div>)}
      </div>
    </div>
  </section>

  <Related title="Nos services et outils" />
  <ContactBand />
</Base>
