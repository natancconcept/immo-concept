---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Questionnaire from "../components/Questionnaire.astro";
import Photo from "../components/Photo.astro";
import Related from "../components/Related.astro";
import { CITIES } from "../data/cities";
import { waLink } from "../data/site";
---
<Base title="Trouver ma ville en Israël" description="Famille, pratique religieuse, travail, santé, communauté francophone et budget : répondez au questionnaire et découvrez les villes d’Israël qui vous correspondent.">
  <section class="tmv-head">
    <div class="wrap tmv-head-grid">
      <div>
        <Crumbs items={[{ label: "Outils" }, { label: "Trouver ma ville" }]} />
        <span class="kicker">Gratuit · 3 minutes · sans inscription</span>
        <h1>Trouver ma ville en Israël</h1>
        <p class="lead">Répondez à quelques questions : nous comparons vos réponses aux {CITIES.length} villes que nous suivons et vous indiquons celles qui vous correspondent le mieux, avec les raisons.</p>
        <ul class="ticks tmv-criteria">
          <li>Famille, enfants et âge</li>
          <li>Pratique religieuse et communauté francophone</li>
          <li>Métier, lieu de travail et santé</li>
          <li>Budget, type de logement, neuf ou ancien</li>
        </ul>
      </div>
      <div class="tmv-photo">
        <Photo src="promenade-tel-aviv" alt="Promenade bordée de palmiers au bord de la mer" sizes="(max-width: 1000px) 0px, 440px" widths={[480, 900]} eager />
      </div>
    </div>
  </section>

  <section class="tmv-body">
    <div class="wrap tmv-grid">
      <div class="tmv-main">
        <Questionnaire readQuery />
        <p class="tmv-note">Vos réponses restent sur votre appareil, sauf si vous nous les envoyez ou demandez le conseil rédigé par l’IA.</p>
      </div>
      <aside class="tmv-side" aria-label="À propos du questionnaire">
        <div class="tmv-box">
          <h2>Et ensuite ?</h2>
          <ol class="tmv-next">
            <li><b>Votre sélection de villes</b><span>Affichée tout de suite, avec un score et les raisons.</span></li>
            <li><b>Un conseiller vous répond</b><span>Envoyez‑nous le résumé sur WhatsApp, en un clic.</span></li>
            <li><b>Les visites</b><span>Sur place ou en vidéo, dans les villes retenues.</span></li>
          </ol>
        </div>
        <div class="tmv-box tmv-help">
          <h2>Une question ?</h2>
          <p>Un conseiller francophone vous répond directement.</p>
          <a class="btn btn-wa" href={waLink("Bonjour, j’ai une question sur le choix de ma ville en Israël.")} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#wa" /></svg>Écrire sur WhatsApp</a>
        </div>
      </aside>
    </div>
  </section>

  <Related exclude="/trouver-ma-ville" title="Pour aller plus loin" />
</Base>
