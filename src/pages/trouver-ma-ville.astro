---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Questionnaire from "../components/Questionnaire.astro";
import Photo from "../components/Photo.astro";
---
<Base title="Trouver ma ville en Israël" description="Famille, pratique religieuse, travail, santé, communauté francophone et budget : répondez au questionnaire et découvrez les villes d’Israël qui vous correspondent.">
  <section class="form-sec tall">
    <div class="wrap form-grid">
      <div class="sec-head">
        <Crumbs items={[{ label: "Trouver ma ville" }]} />
        <h1 style="font-size:clamp(32px,4vw,46px)">Trouver ma ville en Israël</h1>
        <p class="lead">Pour une alyah, le questionnaire tient compte de votre famille, de votre pratique religieuse, de votre métier, de votre santé, de la communauté francophone et de votre budget. Vous obtenez tout de suite les villes qui vous correspondent le mieux, puis un conseiller vous recontacte sur WhatsApp.</p>
        <ul class="asks">
          <li>Famille, enfants et âge</li>
          <li>Pratique religieuse et communauté francophone</li>
          <li>Profession, lieu de travail et besoins de santé</li>
          <li>Budget, type de logement, neuf ou ancien</li>
        </ul>
        <div class="tmv-photo">
          <Photo src="promenade-tel-aviv" alt="Promenade bordée de palmiers au bord de la mer" sizes="(max-width: 900px) 100vw, 40vw" widths={[480, 800]} />
          
        </div>
      </div>
      <Questionnaire readQuery />
    </div>
  </section>
</Base>
